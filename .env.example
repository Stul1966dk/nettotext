# Skabelon. Kopiér denne fil til .env.local og udfyld værdierne.
# .env.local er udelukket i .gitignore og må ALDRIG committes.
# De samme værdier indtastes i Vercels dashboard under Environment Variables.

# --- Supabase (Dashboard → Project Settings → API) -------------------------

# Project URL. Ser ud som https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Den offentlige nøgle ("anon public" / "publishable key").
# Må gerne ses i browseren — RLS beskytter dataene.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# HEMMELIG. "service_role" / "secret key". Omgår alle RLS-regler.
# Kun server-kode må bruge den. Del den aldrig med nogen.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI ---------------------------------------------------------------------

# HEMMELIG. Platformens egen AI-nøgle, der betaler de 5 prøvetekster.
# Fra console.anthropic.com eller platform.openai.com.
PLATFORM_AI_KEY=

# --- Kryptering -------------------------------------------------------------

# HEMMELIG. 32 tilfældige bytes i base64. Krypterer brugernes egne AI-nøgler.
# Skift den aldrig efter idriftsættelse — så kan gemte nøgler ikke læses igen.
# Genereres med: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# --- Budget -----------------------------------------------------------------

# Dagligt loft i kroner for forbrug på PLATFORM_AI_KEY. Overskrides det,
# afvises nye genereringer på platformens regning.
DAILY_BUDGET_DKK=200
